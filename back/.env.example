# Copie este arquivo para ".env" e ajuste os valores.

# Ex: postgresql://usuario:senha@localhost:5432/motoflash?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/motoflash?schema=public"

# Segredo usado para assinar os tokens JWT. Troque por um valor forte em produção.
JWT_KEY="troque-por-um-segredo-forte"

PORT=3000
