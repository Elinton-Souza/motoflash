# Copie este arquivo para ".env" e ajuste os valores.

# --- Banco de dados (Neon: https://neon.tech) ----------------------------
# No painel do Neon, clique em "Connect" e copie as duas strings:
#   DATABASE_URL -> com "Connection pooling" LIGADO (host tem "-pooler")
#                   usada pela API em execução
#   DIRECT_URL   -> com "Connection pooling" DESLIGADO
#                   usada pelo Prisma CLI (migrate deploy, studio, seed)
DATABASE_URL="postgresql://USUARIO:SENHA@ep-xxxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USUARIO:SENHA@ep-xxxxx.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Segredo usado para assinar os tokens JWT. Troque por um valor forte em produção.
JWT_KEY="troque-por-um-segredo-forte"

PORT=3000

# Em produção (Render), defina também:
#   NODE_ENV=production   -> desliga o modo de teste do "Esqueci a senha"
#   TZ=America/Sao_Paulo  -> "hoje" no financeiro segue o horário de Brasília

# Origens que podem chamar a API (separadas por vírgula). Vazio = qualquer origem.
# Em produção: a URL do front na Vercel, ex.: https://motoflash.vercel.app
CORS_ORIGIN=

# --- WhatsApp -----------------------------------------------------------
# Sem provedor, as mensagens aparecem no console da API e as telas oferecem
# um botão "Enviar pelo WhatsApp" (link wa.me). Para envio automático:
#   twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN e TWILIO_WHATSAPP_FROM
#   meta   -> WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do sandbox da Twilio
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Mapa / GPS ----------------------------------------------------------
# Endereços viram coordenadas pelo Nominatim (OpenStreetMap), sem chave.
# Use "true" para desligar (ex.: sem internet).
GEOCODING_DISABLED=false
