# Copie este arquivo para ".env" e ajuste os valores.

# Ex: postgresql://usuario:senha@localhost:5432/motoflash?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/motoflash?schema=public"

# Segredo usado para assinar os tokens JWT. Troque por um valor forte em produção.
JWT_KEY="troque-por-um-segredo-forte"

PORT=3000

# --- WhatsApp -----------------------------------------------------------
# Sem provedor, as mensagens aparecem no console da API e as telas oferecem
# um botão "Enviar pelo WhatsApp" (link wa.me). Para envio automático:
#   twilio -> TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN e TWILIO_WHATSAPP_FROM
#   meta   -> WHATSAPP_TOKEN e WHATSAPP_PHONE_NUMBER_ID
WHATSAPP_PROVIDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número do sandbox da Twilio
TWILIO_WHATSAPP_FROM=+14155238886
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Mapa / GPS ----------------------------------------------------------
# Endereços viram coordenadas pelo Nominatim (OpenStreetMap), sem chave.
# Use "true" para desligar (ex.: sem internet).
GEOCODING_DISABLED=false
